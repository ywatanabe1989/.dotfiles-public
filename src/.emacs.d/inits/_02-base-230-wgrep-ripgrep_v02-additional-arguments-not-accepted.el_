;; \{% --glob "*.html"


(provide '02-base-230-wgrep-ripgrep_v01-from_local)

(when
    (not load-file-name)
  (message "02-base-230-wgrep-ripgrep_v01-from_local.el loaded."
           (file-name-nondirectory
            (or load-file-name buffer-file-name))))