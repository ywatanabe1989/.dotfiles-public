{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/ywatanabe/"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "scitex": {
      "command": "/home/ywatanabe/.venv/bin/scitex",
      "args": ["mcp", "start"],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}"
      }
    },
    "crossref-local": {
      "command": "/home/ywatanabe/.venv/bin/crossref-local",
      "args": ["run-server-mcp"]
    }
  }
}
