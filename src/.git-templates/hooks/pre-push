#!/bin/bash
# ~/.git-templates/hooks/pre-push
# Please locate this file at .git/hooks/pre-push

readonly MASTER='master'
readonly MAIN='main'

is_first_commit() {
    [ $(git rev-list --all --count) -lt 2 ]
}

is_protected_branch() {
    local branch="${1##refs/heads/}"
    [[ "$branch" = "$MASTER" || "$branch" = "$MAIN" ]]
}

print_message() {
    local message="$1"
    local branch="$2"
    echo -e "\033[0;32m$message\033[m \033[1;34m$branch\033[m \033[0;32mbranch\033[m"
}

check_push() {
    local local_ref="$1"
    local local_sha1="$2"
    local remote_ref="$3"
    local remote_sha1="$4"

    if is_protected_branch "$remote_ref"; then
        if is_first_commit; then
            print_message "Allowing first commit to be pushed to" "${remote_ref##refs/heads/}"
        else
            print_message "Do not push to" "${remote_ref##refs/heads/}"
            return 1
        fi
    fi
}

main() {
    while read local_ref local_sha1 remote_ref remote_sha1
    do
        if ! check_push "$local_ref" "$local_sha1" "$remote_ref" "$remote_sha1"; then
            exit 1
        fi
    done
}

main

