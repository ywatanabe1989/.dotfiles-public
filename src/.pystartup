import importlib
import importlib.util
import os
import sys
import warnings
from typing import Optional

warnings.filterwarnings(
    "ignore", "found in sys.modules after import of package", RuntimeWarning
)

print(f"Loading {__file__} ... (PID: {os.getpid()})")


# Lazy loader implementation
class LazyLoader:
    """Lazy module loader - imports module on first attribute access."""

    def __init__(self, module_name: str, package: Optional[str] = None):
        self._module_name = module_name
        self._package = package
        self._module = None

    def _load(self):
        if self._module is None:
            self._module = importlib.import_module(
                self._module_name, self._package
            )
        return self._module

    def __getattr__(self, name: str):
        return getattr(self._load(), name)

    def __repr__(self):
        if self._module is None:
            return f"<LazyLoader({self._module_name}) - not loaded>"
        return repr(self._module)

    def __dir__(self):
        return dir(self._load())


# Lazy load heavy packages (deferred until first use)
np = LazyLoader("numpy")
pd = LazyLoader("pandas")
scipy = LazyLoader("scipy")
plt = LazyLoader("matplotlib.pyplot")
sns = LazyLoader("seaborn")
torch = LazyLoader("torch")
nn = LazyLoader("torch.nn")
F = LazyLoader("torch.nn.functional")

# Fast imports (load immediately)

try:
    from natsort import natsorted
except ImportError:
    natsorted = None


# Enable IPython autoreload
try:
    from IPython import get_ipython

    _ipython = get_ipython()
    if _ipython is not None:
        _ipython.run_line_magic("load_ext", "autoreload")
        _ipython.run_line_magic("autoreload", "2")
except Exception:
    pass


# Terminal plotting (lazy - only imports termplotlib when called)
def tplot(
    *args,
    width=80,
    height=25,
    label=None,
    xlim=None,
    ylim=None,
    xlabel=None,
    title=None,
    extra_gnuplot_arguments=None,
    plot_command="plot '-' w lines",
    ticks_scale=0,
):
    """Terminal plot function (lazy loads termplotlib)."""
    from termplotlib.plot import plot as _tplot

    if len(args) == 1:
        y = args[0]
        x = np.arange(len(y))
    elif len(args) == 2:
        x, y = args
    else:
        raise ValueError("args should be up to 2")
    return _tplot(
        x,
        y,
        width=width,
        height=height,
        label=label,
        xlim=xlim,
        ylim=ylim,
        xlabel=xlabel,
        title=title,
        extra_gnuplot_arguments=extra_gnuplot_arguments,
        plot_command=plot_command,
        ticks_scale=ticks_scale,
    )


# Scitex lazy loaders
stx = LazyLoader("scitex")
scitex = stx

# Lazy scitex helpers (only load when called)
_scitex_initialized = False


def _init_scitex():
    """Initialize scitex on first use."""
    global _scitex_initialized, CONFIG, CC, rng, src, s, logger
    if _scitex_initialized:
        return
    _scitex_initialized = True

    try:
        import scitex as _stx

        CONFIG = _stx.io.load_configs()
    except Exception:
        CONFIG = None

    try:
        import matplotlib.pyplot as _plt
        import scitex as _stx

        globals()["plt"], CC = _stx.plt.utils.configure_mpl(_plt)
    except Exception:
        CC = None

    try:
        import scitex as _stx

        rng = _stx.rng.RandomStateManager(verbose=True)
    except Exception:
        rng = None

    try:
        from scitex.gen import src as _src

        src = _src
        s = _src
    except Exception:
        src = s = None

    try:
        from scitex import logging as _logging

        logger = _logging.getLogger(__name__)
    except Exception:
        logger = None


def init():
    """Explicitly initialize scitex and all lazy imports."""
    _init_scitex()
    # Force load all lazy modules
    _ = np.__version__
    _ = pd.__version__
    print("All modules loaded")


# Reload utility
def reload_pkg(package):
    """Reload a package and all its submodules.

    Args:
        package: Package name (str) or module object to reload

    Returns:
        The reloaded package module
    """
    from types import ModuleType

    package_name = (
        package.__name__ if isinstance(package, ModuleType) else package
    )
    pkg_modules = [
        mod
        for mod in sys.modules
        if mod == package_name or mod.startswith(f"{package_name}.")
    ]
    for module in reversed(pkg_modules):
        try:
            importlib.reload(sys.modules[module])
        except Exception:
            pass
    pkg = importlib.import_module(package_name)
    return importlib.reload(pkg)


def reload_scitex():
    """Reload scitex package and all submodules."""
    return reload_pkg("scitex")


def reload_socialia():
    """Reload socialia package and all submodules."""
    return reload_pkg("socialia")


def r(package_name: str = "scitex"):
    return reload_pkg(package_name)


# Deferred variables (will be set by _init_scitex)
CONFIG = None
CC = None
rng = None
src = s = None
logger = None
