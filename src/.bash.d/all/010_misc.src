## Others
alias office='libreoffice'
alias path='echo -e ${PATH//:/\\n}'
alias clipboard="{ tee /dev/stderr | xsel --clipboard --input; } 2>&1"
alias cl='clear'
alias al="alias"
# alias cb="{ tee /dev/stderr | xsel --clipboard --input; } 2>&1"
alias cb="tee >(xsel --clipboard --input)"

