THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

pdf() {
    WPATH=$(wslpath -w "$1")
    /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -Command \
        "Start-Process \"C:\Program Files\PDFStudio2020\pdfstudio2020.exe\" -ArgumentList \"$WPATH\"" &
    clear
}

