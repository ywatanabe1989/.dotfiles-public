THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

tree_simple () {
    local tgt_dir="$1"
    tree "$tgt_dir" -L 5 -P "*" --noreport | sed 's/ -> .*$//'
}

# EOF