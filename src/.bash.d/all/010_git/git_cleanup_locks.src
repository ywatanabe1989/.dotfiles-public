# alias git="git_cleanup_locks && git"

git() {
    # Checks for and removes Git lock files if no Git processes are running
    if [ -d .git ] && [ -f .git/index.lock ] && ! pgrep -f "^git" > /dev/null; then
        echo "Removing stale .git/index.lock file"
        rm -f .git/index.lock >/dev/null 2>&1
    fi

    # Run the actual git command
    command git "$@"
}

