THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

alias gs="git_sync &"

acps() {
    echo_eval "acp \"$@\" && sleep 0.5 && git_sync -d \"$(pwd)\" &"
}

psy() {
    echo_eval "git push && git_sync -d \"$(pwd)\" &"
}

# EOF