#!/bin/bash
# -*- coding: utf-8 -*-
# Timestamp: "2025-01-13 (ywatanabe)"
# File: /home/ywatanabe/.dotfiles/.bash.d/all/010_git/git_unstage.src

git_unstage() {
    local dry_run=false
    local args=()

    usage() {
        echo "Usage: unstage [-n|--dry-run] [pattern...]"
        echo "Unstage files from git staging area"
        echo
        echo "Options:"
        echo "  -n, --dry-run    Show what would be unstaged without doing it"
        echo "  -h, --help       Show this help"
        echo
        echo "Examples:"
        echo "  unstage                 # Unstage all staged files"
        echo "  unstage file.txt        # Unstage specific file"
        echo "  unstage '**/.old'       # Unstage all .old dirs (quote for glob)"
        echo "  unstage -n '**/*.log'   # Preview what would be unstaged"
    }

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -h | --help)
            usage
            return 0
            ;;
        -n | --dry-run)
            dry_run=true
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
        esac
    done

    # Find staged files matching patterns
    local files
    if [[ ${#args[@]} -eq 0 ]]; then
        files=$(git diff --cached --name-only 2>/dev/null)
    else
        files=$(git diff --cached --name-only -- "${args[@]}" 2>/dev/null)
    fi

    if [[ -z "$files" ]]; then
        echo "No staged files match the pattern."
        return 0
    fi

    echo "=== Files to unstage ==="
    echo "$files"
    echo

    if $dry_run; then
        echo "(Dry run - no changes made)"
        return 0
    fi

    if [[ ${#args[@]} -eq 0 ]]; then
        git restore --staged .
    else
        git restore --staged -- "${args[@]}"
    fi
    echo "Done."
}

alias unstage="git_unstage"

# EOF
