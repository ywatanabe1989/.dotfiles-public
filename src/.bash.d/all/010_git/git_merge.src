#!/bin/bash
# -*- coding: utf-8 -*-
# Timestamp: "2025-05-19 21:46:52 (ywatanabe)"
# File: /home/ywatanabe/.dotfiles/.bash.d/all/010_git/git_merge.src

THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

git_list_unmerged_files() {
    git ls-files --unmerged | cut -f2 | sort -u
}

git_has_merge_conflict() {
    # Checks if a file has merge conflicts
    # Usage: git_has_merge_conflict "path/to/file"
    if [ -f "$1" ]; then
        grep -q "^<<<<<<< HEAD\|^=======\|^>>>>>>>" "$1"
    else
        return 1
    fi
}

git_list_conflicted_files() {
    # Lists conflicted files and checks if all files are resolved
    # Usage: git_list_conflicted_files
    local conflicted_files=()

    export -f git_has_merge_conflict
    mapfile -t conflicted_files < <(git_list_unmerged_files | xargs -P "$(nproc)" -I {} bash -c 'if git_has_merge_conflict "{}"; then echo "{}"; fi')

    if [ ${#conflicted_files[@]} -eq 0 ]; then
        printf "${GREEN}✓ No files have conflicts${NC}\n"
        return 0
    else
        printf "${RED}✗ Unresolved files:${NC}\n"
        printf "${RED}%s${NC}\n" "${conflicted_files[@]}"
        return 1
    fi
}

git_prevent_conflict_commit() {
    # Prevents committing files with conflicts
    # Usage: Add this to .git/hooks/pre-commit
    if git_list_conflicted_files; then
        exit 0
    else
        printf "${RED}Error: You have unresolved conflicts. Please resolve them before committing.${NC}\n"
        exit 1
    fi
}

git_merge_and_delete() {
    if [ -z "$1" ]; then
        echo "Usage: git_merge_and_delete <branch_name>"
        return 1
    fi
    branch_name=$1
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    echo "About to merge branch '$branch_name' into current branch '$current_branch'."
    read -p "Continue? (y/n): " confirm
    if [[ "$confirm" != "y" ]]; then
        echo "Operation cancelled."
        return 1
    fi
    if git merge "$branch_name"; then
        echo "Merge successful. About to delete branch '$branch_name'."
        read -p "Proceed with deletion? (y/n): " confirm_delete
        if [[ "$confirm_delete" == "y" ]]; then
            git branch -d "$branch_name"
            echo "Branch '$branch_name' deleted."
        else
            echo "Branch '$branch_name' was not deleted."
        fi
    else
        echo "Merge failed. Branch '$branch_name' not deleted."
        return 1
    fi
}

git_merge_and_delete_into() {
    # Merges the current branch into the target branch and deletes current branch if successful
    # Usage: git_merge_and_delete_into <target_branch>
    if [ -z "$1" ]; then
        echo "Usage: git_merge_and_delete_into <target_branch>"
        return 1
    fi
    target_branch=$1
    current_branch=$(git rev-parse --abbrev-ref HEAD)

    echo "About to merge '$current_branch' into '$target_branch' and delete '$current_branch' if successful."
    read -p "Continue? (y/n): " confirm
    if [[ "$confirm" != "y" ]]; then
        echo "Operation cancelled."
        return 1
    fi

    # Save changes if any
    git_stash_if_needed
    # Switch to target branch
    if ! git checkout "$target_branch"; then
        echo "Failed to checkout $target_branch"
        git_stash_pop_if_needed
        return 1
    fi
    # Make sure target branch is up to date
    git pull
    # Merge the feature branch
    if git merge "$current_branch"; then
        # If merge successful, delete the feature branch
        echo "Merge successful. About to delete branch '$current_branch'."
        read -p "Proceed with deletion? (y/n): " confirm_delete
        if [[ "$confirm_delete" == "y" ]]; then
            git branch -d "$current_branch"
            echo "Branch '$current_branch' deleted."
        else
            echo "Branch '$current_branch' was not deleted."
        fi
        git_stash_pop_if_needed
        return 0
    else
        echo "Merge conflict occurred. Resolve conflicts and commit manually."
        git_stash_pop_if_needed
        return 1
    fi
}

# Helper functions to preserve uncommitted changes
git_stash_if_needed() {
    # Stash changes if there are any, and set a flag
    if [ -n "$(git status --porcelain)" ]; then
        echo "Stashing uncommitted changes..."
        export GIT_HAD_STASH=1
        git stash push -m "Automatic stash by git_merge_and_delete_into"
    else
        export GIT_HAD_STASH=0
    fi
}
git_stash_pop_if_needed() {
    # Pop stashed changes if we stashed any
    if [ "${GIT_HAD_STASH:-0}" -eq 1 ]; then
        echo "Restoring stashed changes..."
        git stash pop
        unset GIT_HAD_STASH
    fi
}
# Bash completion for git_merge_and_delete
_git_merge_and_delete_completion() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Complete with branch names
    if [[ ${COMP_CWORD} -eq 1 ]]; then
        local branches=$(git branch --format='%(refname:short)')
        COMPREPLY=($(compgen -W "${branches}" -- "${cur}"))
    fi
    return 0
}

# Bash completion for git_merge_and_delete_into
_git_merge_and_delete_into_completion() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Complete with branch names
    if [[ ${COMP_CWORD} -eq 1 ]]; then
        local branches=$(git branch --format='%(refname:short)')
        COMPREPLY=($(compgen -W "${branches}" -- "${cur}"))
    fi
    return 0
}

# Register completions
complete -F _git_merge_and_delete_completion git_merge_and_delete
complete -F _git_merge_and_delete_into_completion git_merge_and_delete_into
complete -F _git_merge_and_delete_completion gmd
complete -F _git_merge_and_delete_into_completion gmdt

# Create an alias for easier use
alias gmd='git_merge_and_delete'
alias gmdt='git_merge_and_delete_into'

# EOF