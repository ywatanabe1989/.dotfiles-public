#!/bin/bash
# -*- coding: utf-8 -*-
# Timestamp: "2025-05-12 12:48:12 (ywatanabe)"
# File: /home/ywatanabe/.bash.d/all/010_check_command.src

THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

_check_bin() {
    local command="$1"
    if declare -F "$command" > /dev/null; then
        echo "$command is a function"
        declare -f "$command"
    elif command -v "$command" &>/dev/null; then
        type -a "$command"
        which "$command"
    else
        echo "$command not found"
    fi
}

_check_alias() {
    local command="$1"
    local alias_info=$(grep -R "alias ${command}=" ~/.bashrc ~/.bash.d/*/* 2>/dev/null)
    if [ -n "$alias_info" ]; then
        echo "$alias_info" | while read -r line; do
            echo "alias @ ${line%%:*}"
            echo "${line#*:}"
            echo
        done
        echo "Effective definition:"
        alias "$command"
    fi
}

_check_function() {
    local command="$1"
    if declare -F "$command" > /dev/null; then
        echo "Defined in: $(grep -R "${command}()" ~/.bashrc ~/.bash.d/*/* 2>/dev/null | cut -d: -f1)"
        declare -f "$command"
    fi
}


check_command() {
    local command="$1"
    if declare -F "$command" > /dev/null; then
        echo "Defined in: $(grep -R "${command}()" ~/.bashrc ~/.bash.d/*/* 2>/dev/null | cut -d: -f1)"
        declare -f "$command"
    else
        _check_bin "$command"
    fi
    _check_alias "$command"
}

alias c='check_command'

# EOF