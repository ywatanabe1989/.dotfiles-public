take_photo() {
    ## Web Camera Installation
    # ```powershell
    # # attach-webcam.ps1
    # $busid = (usbipd list | Select-String "HD Pro Webcam C920" | ForEach-Object { $_.ToString().Split()[0] })
    # if ($busid) {
    #     usbipd attach --wsl --busid $busid
    # }
    # ```
    # cd $:\path\to\attach-webcam.ps1-directory\
    # PowerShell -ExecutionPolicy Bypass -File "attach-webcam.ps1"
    # Create shortcut and place to `shell:startup`

    local countdown=0
    local output_file=""
    local positional_args=()

    while [[ $# -gt 0 ]]; do
        case $1 in
        -c | --countdown)
            countdown="$2"
            shift 2
            ;;
        -h | --help)
            echo "Usage: take_photo [-c|--countdown SECONDS] [OUTPUT_FILE]"
            echo "  -c, --countdown  Countdown seconds (default: 3)"
            echo "  -h, --help       Show this help"
            return 0
            ;;
        *)
            positional_args+=("$1")
            shift
            ;;
        esac
    done

    if [ ${#positional_args[@]} -gt 0 ]; then
        output_file="${positional_args[0]}"
    fi
    output_file="${output_file:-photo_$(date +%Y%m%d_%H%M%S).jpg}"

    for ((ii = countdown; ii >= 1; ii--)); do
        echo "$ii..."
        sleep 1
    done
    echo "Snap!"

    ffmpeg -f v4l2 -i /dev/video0 -vframes 1 "$output_file" -loglevel quiet
    if [ -f "$output_file" ]; then
        echo "Photo saved: $output_file"
    else
        echo "Photo not saved"
    fi
}

take_photos() {
    local countdown=3
    local interval=1
    local duration=10
    local output_prefix=""
    local positional_args=()

    while [[ $# -gt 0 ]]; do
        case $1 in
        -c | --countdown)
            countdown="$2"
            shift 2
            ;;
        -i | --interval)
            interval="$2"
            shift 2
            ;;
        -d | --duration)
            duration="$2"
            shift 2
            ;;
        -h | --help)
            echo "Usage: take_photos [-c|--countdown SECONDS] [-i|--interval SECONDS] [-d|--duration SECONDS] [OUTPUT_PREFIX]"
            echo "  -c, --countdown  Countdown seconds (default: 3)"
            echo "  -i, --interval   Interval between photos (default: 1)"
            echo "  -d, --duration   Total duration (default: 10)"
            echo "  -h, --help       Show this help"
            return 0
            ;;
        *)
            positional_args+=("$1")
            shift
            ;;
        esac
    done

    if [ ${#positional_args[@]} -gt 0 ]; then
        output_prefix="${positional_args[0]}"
    fi
    output_prefix="${output_prefix:-photos_$(date +%Y%m%d_%H%M%S)}"

    for ((ii = countdown; ii >= 1; ii--)); do
        echo "$ii..."
        sleep 1
    done
    echo "Starting photo sequence..."

    local end_time=$(($(date +%s) + duration))
    local photo_count=1

    while [ $(date +%s) -lt $end_time ]; do
        local output_file="${output_prefix}_$(printf "%03d" $photo_count).jpg"
        ffmpeg -f v4l2 -i /dev/video0 -vframes 1 "$output_file" -loglevel quiet
        if [ -f "$output_file" ]; then
            echo "Photo $photo_count saved: $output_file"
        fi
        ((photo_count++))
        sleep $interval
    done

    echo "Photo sequence complete"
}

take_movie() {
    local countdown=0
    local duration=""
    local output_file=""

    ## Web Camera Installation
    # ```powershell
    # # attach-webcam.ps1
    # $busid = (usbipd list | Select-String "HD Pro Webcam C920" | ForEach-Object { $_.ToString().Split()[0] })
    # if ($busid) {
    #     usbipd attach --wsl --busid $busid
    # }
    # ```
    # cd $:\path\to\attach-webcam.ps1-directory\
    # PowerShell -ExecutionPolicy Bypass -File "attach-webcam.ps1"
    # Create shortcut and place to `shell:startup`

    while [[ $# -gt 0 ]]; do
        case $1 in
        -c | --countdown)
            countdown="$2"
            shift 2
            ;;
        -h | --help)
            echo "Usage: take_movie [-c|--countdown SECONDS] [DURATION] [OUTPUT_FILE]"
            echo "  -c, --countdown  Countdown seconds (default: 3)"
            echo "  -h, --help       Show this help"
            echo "  DURATION         Recording duration in seconds (default: 10)"
            return 0
            ;;
        *)
            if [ -z "$duration" ]; then
                duration="$1"
            else
                output_file="$1"
            fi
            shift
            ;;
        esac
    done

    countdown="${countdown:-3}"
    duration="${duration:-10}"
    output_file="${output_file:-movie_$(date +%Y%m%d_%H%M%S).mp4}"

    for ((ii = countdown; ii >= 1; ii--)); do
        echo "$ii..."
        sleep 1
    done
    echo "Recording... Press Ctrl+C to stop early"

    ffmpeg -f v4l2 -i /dev/video0 -t "$duration" -c:v libx264 -pix_fmt yuv420p "$output_file" -loglevel quiet
    if [ -f "$output_file" ]; then
        echo "Movie saved: $output_file"
    else
        echo "Recording stopped"
    fi
}

