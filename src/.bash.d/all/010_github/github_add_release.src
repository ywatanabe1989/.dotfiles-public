#!/bin/bash
# -*- coding: utf-8 -*-
# Timestamp: "2025-03-08 14:46:26 (ywatanabe)"
# File: /home/ywatanabe/.bash.d/all/010_github/github_add_release.src

THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Color definitions
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Release handling functions
_list_releases() {
    echo "Current releases:"
    gh release list
}

_handle_release_creation() {
    local tag_name=$1
    read -p "Create release? (Y/n): " create_release
    if [[ -z "$create_release" || $create_release =~ ^[Yy]$ ]]; then
        read -p "Is this a pre-release? (y/N): " is_prerelease
        read -p "Release title (press enter to use $tag_name): " release_title
        local prerelease_flag=""
        [[ $is_prerelease =~ ^[Yy]$ ]] && prerelease_flag="--prerelease"
        local title=${release_title:-$tag_name}
        gh release create "$tag_name" \
           $prerelease_flag \
           --generate-notes \
           --target main \
           --title "$title"
    fi
}

_handle_tag_creation() {
    read -p "Would you like to create a tag? (Y/n): " create_tag
    if [[ -z "$create_tag" || $create_tag =~ ^[Yy]$ ]]; then
        # List existing tags
        list_releases
        read -p "Enter tag name (e.g., v1.0.0): " tag_name
        git tag -a "$tag_name" -m "Release $tag_name"
        git push origin "$tag_name"
        handle_release_creation "$tag_name"
    fi
}

gh_add_release() {
    # Authenticate with GitHub
    unset GITHUB_TOKEN
    gh auth login --with-token < $HOME/.bash.d/secrets/access_tokens/github.txt || {
        echo "Failed to authenticate with GitHub"
        return 1
    }

    # Check current branch
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [ "$current_branch" != "main" ]; then
        echo "This script should be run from main branch"
        read -p "Switch to main branch? (Y/n): " switch_to_main
        if [[ -z "$switch_to_main" || $switch_to_main =~ ^[Yy]$ ]]; then
            git switch main
        else
            exit 1
        fi
    fi

    # Pull latest changes
    git pull origin main

    # Handle release creation
    _handle_tag_creation
}

# EOF