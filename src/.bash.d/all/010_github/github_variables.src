THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


if_user ywatanabe export GITHUB_USERNAME="ywatanabe1989"
if_user ywatanabe export GITHUB_URL=git@github.com:ywatanabe1989
if_user ywatanabe export GITHUB_BROWSER_CMD="powershell.exe Start-Process"
if_user ywatanabe alias github="github"
if_user ywatanabe alias 'gh_'="github"

if_user yusukew export GITHUB_USERNAME="ywatanabe1989"
if_user yusukew export GITHUB_URL=git@github.com:ywatanabe1989
if_user yusukew export GITHUB_BROWSER_CMD="powershell.exe Start-Process"
if_user yusukew alias github="github"
if_user yusukew alias 'gh_'="github"

