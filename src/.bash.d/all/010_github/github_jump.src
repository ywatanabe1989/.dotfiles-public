#!/bin/bash
# -*- coding: utf-8 -*-
# Timestamp: "2025-04-17 05:46:28 (ywatanabe)"
# File: /home/ywatanabe/.dotfiles/.bash.d/all/010_github/github_jump.src

THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


function github() {
    # Get GitHub username from the repository URL or fallback to environment variable
    local github_username="ywatanabe1989"  # Default fallback

    if [[ -n "$GITHUB_USERNAME" ]]; then
        github_username="$GITHUB_USERNAME"
    elif [[ -n "$GITHUB_URL" ]]; then
        github_username=$(echo "$GITHUB_URL" | sed -E 's/.*github.com:([^/]+).*/\1/')
    fi

    # Default user repositories URL
    local default_url="https://github.com/${github_username}?tab=repositories"

    if git rev-parse --is-inside-work-tree &>/dev/null; then
        # Get remote URL
        local remote_url=$(git remote get-url origin 2>/dev/null)

        # If remote URL exists and appears to be a GitHub URL
        if [[ -n "$remote_url" ]] && [[ "$remote_url" == *"github.com"* ]]; then
            # Convert SSH URL to HTTPS format if needed
            if [[ "$remote_url" == git@github.com:* ]]; then
                repo_path="${remote_url#git@github.com:}"
                repo_path="${repo_path%.git}"
                web_url="https://github.com/$repo_path"
            elif [[ "$remote_url" == https://github.com/* ]]; then
                web_url="${remote_url%.git}"
            else
                web_url="$remote_url"
            fi

            # Check if we're on a branch and add it to URL
            local branch=$(git symbolic-ref --short HEAD 2>/dev/null)
            if [[ -n "$branch" ]]; then
                web_url="$web_url/tree/$branch"
            fi

            # Use browser command from environment if available
            if [[ -n "$GITHUB_BROWSER_CMD" ]]; then
                eval "$GITHUB_BROWSER_CMD \"$web_url\"" &
            else
                powershell.exe Start-Process "$web_url" &
            fi
        else
            # Default to user's repositories page if not in a GitHub repo
            if [[ -n "$GITHUB_BROWSER_CMD" ]]; then
                eval "$GITHUB_BROWSER_CMD \"$default_url\"" &
            else
                powershell.exe Start-Process "$default_url" &
            fi
        fi
    else
        # Default behavior if not in a Git repository
        if [[ -n "$GITHUB_BROWSER_CMD" ]]; then
            eval "$GITHUB_BROWSER_CMD \"$default_url\"" &
        else
            powershell.exe Start-Process "$default_url" &
        fi
    fi
}

# EOF