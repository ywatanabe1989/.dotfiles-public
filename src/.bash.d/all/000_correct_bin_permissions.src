THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

_bin_correct_permissions() {
    find "$HOME/.bin" -type f -exec chmod +x {} +
}

_bin_correct_permissions

# EOF