THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

# Script created on: 2024-06-22 11:53:47
# Script path: /home/ywatanabe/.dotfiles/.bash.d/all/030-dry_run.sh

dry_run () {
    local DRY_RUN=$1
    shift
    local command="$@"

    if [ "$DRY_RUN" = true ]; then
       echo -e "\n (Dry Run) $command"
    else
       echo -e "\n$command"
       eval "$command"
    fi
}

# EOF