THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

sclean() {
    # Clean SLURM log files from current and slurm_logs directories
    # Example: sclean_logs

    directories=("." "./slurm_logs")

    for dir in "${directories[@]}"; do
        if [[ -d "$dir" ]]; then
            rm -f "$dir"/*.out
            rm -f "$dir"/*.err
            echo "Cleaned logs from: $dir"
        fi
    done
}

# EOF