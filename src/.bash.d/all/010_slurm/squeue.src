_get_jobid() {
    local index=$1
    local jobs=($(squeue -h -u $USER -o "%i" | sed 's/\[.*\]//g'))
    local n=${#jobs[@]}

    if [[ $index =~ ^-[0-9]+$ ]]; then
        index=$((n + index))
    else
        ((index--))
    fi

    if [ $index -lt 0 ] || [ $index -ge $n ]; then
        return 1
    fi

    job_id="${jobs[$index]}"
    echo "$job_id"
    return 0
}

# Get job name from index
_get_jobname() {
    local index=$1
    squeue -u $USER -h -o "%j" | sed -n "${index}p"
}

# # Alias for squeue with indices
# _watch_list_jobs() {
#     export _SLURM_FORMAT
#     export -f _list_jobs printf
#     BASH_ENV=<(declare -f _list_jobs) watch -n 1 -d bash -c '_list_jobs'
# }
# Alias for squeue with indices
_watch_list_jobs() {
    export _SLURM_FORMAT
    export -f _list_jobs
    BASH_ENV=<(declare -f _list_jobs) watch -n 1 -d bash -c '_list_jobs'
}

alias s="_watch_list_jobs"

alias sqid="squeue -u $USER -h -o '%i'"


_s_running() {
    local fmt="%-4s %-16s %-10s %-4s %-5s %-20s %-15s %-3s %-7s %-11s %-11s\n"
    printf "$fmt" "IDX" "JOBID" "NAME" "ST" "NODES" "NODELIST(REASON)" "TRES_PER_NODE" "CPU" "MIN_MEM" "TIME_LIMIT" "TIME_LEFT"
    printf "%s\n" "--------------------------------------------------------------------------------------------------"

    local counter=1
    squeue -u $USER -h -o "$_SLURM_FORMAT" -t RUNNING | while read -r jobid name state nodes nodelist tres cpu mem tlimit tleft; do
        printf "$fmt" "[$counter]" "$jobid" "$name" "$state" "$nodes" "$nodelist" "$tres" "$cpu" "$mem" "$tlimit" "$tleft"
        counter=$((counter + 1))
    done
}

_watch_running_jobs() {
    export _SLURM_FORMAT
    export -f _s_running
    BASH_ENV=<(declare -f _s_running) watch -n 1 -d bash -c '_s_running'
}

alias s_running="_watch_running_jobs"

