THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ---------------------------------------

# Slurm format string
_SLURM_FORMAT="%i %j %t %D %R %b %C %m %l %L"

# Format output with column widths
_list_jobs() {
    local fmt="%-4s %-16s %-10s %-4s %-5s %-20s %-15s %-3s %-7s %-11s %-11s\n"
    printf "$fmt" "IDX" "JOBID" "NAME" "ST" "NODES" "NODELIST(REASON)" "TRES_PER_NODE" "CPU" "MIN_MEM" "TIME_LIMIT" "TIME_LEFT"
    printf "%s\n" "--------------------------------------------------------------------------------------------------"

    local counter=1
    squeue -u $USER -h -o "$_SLURM_FORMAT" | while read -r jobid name state nodes nodelist tres cpu mem tlimit tleft; do
        printf "$fmt" "[$counter]" "$jobid" "$name" "$state" "$nodes" "$nodelist" "$tres" "$cpu" "$mem" "$tlimit" "$tleft"
        counter=$((counter + 1))
    done
}

