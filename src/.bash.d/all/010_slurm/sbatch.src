THIS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


sbatch() {
    mkdir -p ./slurm_logs
    command sbatch --output=./slurm_logs/%j.out --error=./slurm_logs/%j.err "$@"
}

